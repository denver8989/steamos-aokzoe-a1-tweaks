[Desktop Entry]
Type=Application
Name=Set Up A1 Extras
Comment=After installing SteamOS: optional Decky, 30 W profile and A1 controller glyphs
Exec=python3 -c "import os,sys; from urllib.parse import urlparse,unquote; p=sys.argv[1]; p=unquote(urlparse(p).path) if p.startswith('file:') else p; os.execv('/usr/bin/python3',['python3',os.path.join(os.path.dirname(p),'tools','desktop.py'),'extras'])" %k
Icon=utilities-terminal
Terminal=false
Categories=System;
