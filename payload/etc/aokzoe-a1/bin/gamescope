#!/bin/bash
# Add a supported absolute orientation option to the current vendor gamescope.
set -u
args=()
if [[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) = AOKZOE && $(cat /sys/class/dmi/id/product_name 2>/dev/null) = 'AOKZOE A1 AR07' ]] && [[ ! -e /etc/aokzoe-a1/disabled ]] && ! grep -qw 'aokzoe_a1.stock=1' /proc/cmdline; then
  explicit=0
  for arg in "$@"; do
    case "$arg" in --force-orientation|--force-orientation=*) explicit=1;; esac
  done
  if [[ $explicit = 0 ]]; then
    if /usr/bin/gamescope --help 2>&1 | grep -q -- '--force-orientation'; then
      args=(--force-orientation left)
    else
      echo 'AOKZOE A1: orientation option changed; starting vendor gamescope unchanged' >&2
    fi
  fi
fi
exec /usr/bin/gamescope "${args[@]}" "$@"
